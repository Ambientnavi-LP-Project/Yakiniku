  /* TableCheck のロケール（URL の /ja/ の部分）を、いま表示している言語に合わせて差し替える。
     日本語の予約画面に飛ばすと、外国語の来店客がそこで離脱するため。

     ★公開前に、下の4つのURLをブラウザで開いて表示されるか確認してください。
       もし開かないロケールがあれば、その行の値を "ja" に戻せば日本語の予約画面に飛びます。
       この仕組み自体を使わない場合は、下の行をすべて "ja" にしてください。
         https://www.tablecheck.com/en/wagyu-yakiniku-nipponbashi/reserve
         https://www.tablecheck.com/zh-CN/wagyu-yakiniku-nipponbashi/reserve
         https://www.tablecheck.com/zh-TW/wagyu-yakiniku-nipponbashi/reserve
         https://www.tablecheck.com/ko/wagyu-yakiniku-nipponbashi/reserve */
  var TC_LOCALE = { en:"en", zh:"zh-CN", zt:"zh-TW", ko:"ko" };
  function syncReserveLocale(lang){
    var loc = TC_LOCALE[lang] || "en";
    document.querySelectorAll('a[href*="tablecheck.com/"]').forEach(function(a){
      a.href = a.href.replace(/tablecheck\.com\/[a-zA-Z-]+\//, 'tablecheck.com/' + loc + '/');
    });
  }

  function applyLanguage(lang){
    var dict = translations[lang] || translations.en;
    document.querySelectorAll('[data-i18n]').forEach(function(el){
      var k = el.getAttribute('data-i18n');
      if (dict[k] !== undefined) el.innerHTML = dict[k];
    });
    var HTMLLANG = { en:"en", zh:"zh-Hans", zt:"zh-Hant", ko:"ko" };
    document.documentElement.setAttribute('lang', HTMLLANG[lang] || 'en');
    document.querySelectorAll('.lang button').forEach(function(b){
      b.classList.toggle('active', b.getAttribute('data-lang') === lang);
    });
    syncReserveLocale(lang);
    try { localStorage.setItem('preferred_lang', lang); } catch(e){}
    document.dispatchEvent(new Event('langchange'));
  }

  document.querySelectorAll('.lang button').forEach(function(b){
    b.addEventListener('click', function(){ applyLanguage(b.getAttribute('data-lang')); });
  });

  syncReserveLocale('en');

  (function initLang(){
    var saved=null;
    try { saved = localStorage.getItem('preferred_lang'); } catch(e){}
    if (saved && translations[saved]) { if (saved !== 'en') applyLanguage(saved); return; }
    var n = (navigator.language || 'en').toLowerCase();
    if (n.indexOf('ko') === 0) applyLanguage('ko');
    else if (n.indexOf('zh') === 0) applyLanguage((n.indexOf('tw')>-1||n.indexOf('hk')>-1||n.indexOf('hant')>-1) ? 'zt' : 'zh');
  })();
</script>
