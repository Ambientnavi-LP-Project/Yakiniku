---
pagination:
  data: stores.stores
  size: 1
  alias: store
permalink: "/{{ store.region }}/{{ store.slug }}/index.html"
---
{%- set desc = "All-you-can-eat wagyu yakiniku in " + store.city + ". Raised on our own farm since 1962, grilled at your table. " + store.name -%}
{%- set canonical = stores.domain + "/" + store.region + "/" + store.slug + "/" -%}
{#- 社内名称: {{ store.internal_name }} -#}
<!doctype html>
<html lang="en" data-store="{{ store.region }}-{{ store.slug }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ store.name }}</title>
<meta name="description" content="{{ desc }}">
<link rel="canonical" href="{{ canonical }}">
<meta property="og:type" content="restaurant.restaurant">
<meta property="og:title" content="{{ store.name }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ stores.domain }}/{{ stores.og_image }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#17130F">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..600&family=IBM+Plex+Mono:wght@400;500&family=Yellowtail&display=swap" rel="stylesheet">

{%- if stores.gtm_id %}
<script>window.dataLayer=window.dataLayer||[];(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','{{ stores.gtm_id }}');</script>
{%- else %}
<script>window.dataLayer=window.dataLayer||[];</script>
{%- endif %}

<style>
/* ============================================================
   Farm to Table — tokens
   paper : ロゴの生成り  /  sumi : 墨  /  seal : 落款の朱
   tag   : 耳標の黄（アクセントは1か所だけ）
   ============================================================ */
:root{
  --paper:#F4EEDF; --paper-2:#EAE1CC; --paper-3:#DED2B8;
  --sumi:#17130F;  --sumi-2:#211B15;  --sumi-3:#0E0B09;
  --seal:#B4382C;  --tag:#E8B32C;
  --ink-soft:#5B5044; --ash:#9C907E;
  --rule:rgba(23,19,15,.18); --rule-d:rgba(244,238,223,.17);

  --f-disp:"Fraunces",Georgia,"Times New Roman",serif;
  --f-mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  --f-script:"Yellowtail",cursive;
  --f-body:-apple-system,BlinkMacSystemFont,"Segoe UI","Hiragino Sans",
    "Hiragino Kaku Gothic ProN","Noto Sans JP","Yu Gothic",
    "PingFang SC","PingFang TC","Microsoft YaHei","Microsoft JhengHei",
    "Apple SD Gothic Neo","Malgun Gothic",sans-serif;

  --wrap:1180px;
  --gut:clamp(20px,5vw,60px);
  --band:clamp(74px,10vw,136px);
}

*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{
  margin:0;background:var(--paper);color:var(--sumi);
  font-family:var(--f-body);font-size:15.5px;line-height:1.85;
  letter-spacing:.01em;-webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
img,iframe{max-width:100%;display:block}
a{color:inherit}
h1,h2,h3,p,ul,ol,figure,blockquote{margin:0;padding:0}
ul,ol{list-style:none}
:focus-visible{outline:2px solid var(--seal);outline-offset:3px}
.sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}

.wrap{width:100%;max-width:var(--wrap);margin-inline:auto;padding-inline:var(--gut)}
.band{padding-block:var(--band)}
.band--paper{background:var(--paper)}
.band--dark{background:var(--sumi);color:var(--paper)}

/* ---- shared type ------------------------------------------------------ */
.eyebrow{
  font-family:var(--f-mono);font-size:10.5px;font-weight:500;
  letter-spacing:.26em;text-transform:uppercase;color:var(--ash);
  display:flex;align-items:center;gap:14px;
}
.eyebrow::after{content:"";flex:1;height:1px;background:var(--rule)}
.band--dark .eyebrow::after{background:var(--rule-d)}

.h2{
  font-family:var(--f-disp);font-optical-sizing:auto;
  font-weight:400;font-size:clamp(29px,4.6vw,54px);line-height:1.1;
  letter-spacing:-.015em;margin-top:26px;max-width:20ch;
}
.lede{font-size:clamp(15.5px,1.5vw,17px);line-height:1.9;color:var(--ink-soft);max-width:56ch}
.band--dark .lede{color:#C3B8A6}

/* ============================================================ TOPBAR */
.topbar{
  position:fixed;inset:0 0 auto 0;z-index:60;
  display:flex;align-items:center;justify-content:space-between;
  gap:16px;padding:10px var(--gut);
  background:rgba(23,19,15,.92);backdrop-filter:blur(10px);
  border-bottom:1px solid var(--rule-d);
  transform:translateY(-102%);transition:transform .38s cubic-bezier(.4,0,.2,1);
}
.topbar.is-on{transform:translateY(0)}
.topbar__mark{font-family:var(--f-script);font-size:22px;color:var(--paper);text-decoration:none;line-height:1;padding-block:4px}
.topbar__nav{display:flex;align-items:center;gap:8px}
.topbar__link{
  font-family:var(--f-mono);font-size:10.5px;letter-spacing:.18em;
  text-transform:uppercase;color:#C3B8A6;text-decoration:none;padding:8px 10px;
}
.topbar__link:hover{color:var(--paper)}
@media(max-width:700px){.topbar__link{display:none}}

/* ---- buttons ---------------------------------------------------------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  font-family:var(--f-mono);font-size:11px;font-weight:500;
  letter-spacing:.2em;text-transform:uppercase;text-decoration:none;
  padding:14px 24px;border:1px solid transparent;border-radius:1px;
  transition:background .22s ease,color .22s ease,border-color .22s ease;
  white-space:nowrap;cursor:pointer;
}
.btn--fill{background:var(--seal);color:#FBF7EE;border-color:var(--seal)}
.btn--fill:hover{background:#9C2E24;border-color:#9C2E24}
.btn--ghost{border-color:rgba(244,238,223,.42);color:var(--paper)}
.btn--ghost:hover{border-color:var(--paper);background:rgba(244,238,223,.08)}
.btn--dark{border-color:var(--rule);color:var(--sumi)}
.btn--dark:hover{background:var(--sumi);color:var(--paper);border-color:var(--sumi)}
.btn--sm{padding:10px 16px;font-size:10px}

/* ============================================================ HERO */
.hero{position:relative;min-height:calc(100svh - var(--bar,0px));display:flex;flex-direction:column;background:var(--sumi-3);overflow:hidden}
.hero__media{position:absolute;inset:0}
.hero__shot{
  position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
  opacity:0;transition:opacity 1.5s ease;transform:scale(1.06);
  animation:drift 22s ease-in-out infinite alternate;
}
.hero__shot.is-on{opacity:1}
@keyframes drift{from{transform:scale(1.04) translate3d(0,0,0)}to{transform:scale(1.13) translate3d(-1.2%,-1.4%,0)}}
.hero__scrim{
  position:absolute;inset:0;
  background:
    radial-gradient(120% 85% at 50% 44%,rgba(14,11,9,.42) 0%,rgba(14,11,9,.78) 62%,rgba(14,11,9,.93) 100%),
    linear-gradient(180deg,rgba(14,11,9,.72) 0%,rgba(14,11,9,0) 26%,rgba(14,11,9,0) 62%,rgba(14,11,9,.9) 100%);
}
.hero__inner{
  position:relative;flex:1;display:flex;flex-direction:column;
  align-items:center;justify-content:center;text-align:center;
  padding:120px var(--gut) 40px;color:var(--paper);
}

/* ---- wordmark (ロゴのロックアップをCSSで再現) ---- */
.mk{display:block;line-height:1}
.mk__over{
  display:block;font-family:var(--f-mono);font-size:clamp(8.5px,1.4vw,10px);font-weight:500;
  letter-spacing:.3em;text-transform:uppercase;line-height:1.9;color:rgba(244,238,223,.72);
}
.mk__cjk{font-size:clamp(9.5px,1.7vw,12px);letter-spacing:.4em;color:rgba(244,238,223,.62);line-height:1.9;margin-top:.55em}
.mk__word{
  font-family:var(--f-script);font-weight:400;white-space:nowrap;
  font-size:clamp(46px,8.4vw,90px);line-height:1.05;
  margin:.06em 0 .1em;letter-spacing:-.005em;
  text-shadow:0 2px 34px rgba(0,0,0,.55);
}
.mk__mid{position:relative;display:inline-block;padding-inline:.06em}
.mk__seal{
  position:absolute;left:50%;top:50%;
  width:.66em;height:.66em;transform:translate(-50%,-56%) rotate(1.5deg);
  border:.045em solid var(--seal);border-radius:.03em;
}
.mk__est{font-family:var(--f-disp);font-style:italic;font-weight:300;font-size:clamp(13px,2vw,16px);letter-spacing:.22em;color:rgba(244,238,223,.66)}
.mk__rule{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:16px}
.mk__rule::before,.mk__rule::after{content:"";width:clamp(28px,7vw,64px);height:1px;background:rgba(244,238,223,.3)}

.hero__sub{
  margin-top:30px;max-width:34ch;font-size:clamp(14.5px,1.7vw,17px);
  line-height:1.85;color:rgba(244,238,223,.9);text-wrap:balance;
}
.hero__cta{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:34px}

.hero__foot{
  position:relative;border-top:1px solid rgba(244,238,223,.18);
  padding:14px var(--gut) calc(14px + env(safe-area-inset-bottom));
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  font-family:var(--f-mono);font-size:10.5px;letter-spacing:.18em;
  text-transform:uppercase;color:rgba(244,238,223,.72);
  background:rgba(14,11,9,.5);
}
.hero__foot span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hero__foot .dot{color:var(--tag)}
@media(min-width:641px){.hero__foot{padding-right:calc(var(--gut) + 258px)}}
@media(max-width:640px){.hero__foot{font-size:9.5px;letter-spacing:.14em;padding-bottom:calc(58px + env(safe-area-inset-bottom))}.hero__foot .hide-s{display:none}}

/* ============================================================ TRACEABILITY */
.trace__head{max-width:62ch}
.ledger{
  margin-top:52px;border:1px solid var(--rule);background:rgba(255,255,255,.36);
  display:grid;grid-template-columns:repeat(3,1fr);
}
.ledger__cell{padding:32px clamp(20px,3vw,34px) 34px;border-left:1px solid var(--rule)}
.ledger__cell:first-child{border-left:0}
.ledger__k{font-family:var(--f-mono);font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--ash)}
.ledger__t{font-family:var(--f-disp);font-weight:400;font-size:clamp(21px,2.6vw,27px);line-height:1.25;margin:12px 0 12px;letter-spacing:-.01em}
.ledger__d{font-size:14px;line-height:1.85;color:var(--ink-soft)}
@media(max-width:820px){
  .ledger{grid-template-columns:1fr}
  .ledger__cell{border-left:0;border-top:1px solid var(--rule)}
  .ledger__cell:first-child{border-top:0}
}

/* 耳標チップ — 黄色を使うのはページ中このひとつだけ */
.eartag{display:inline-flex;align-items:stretch;margin-top:26px;border:1px solid var(--rule);background:#fff}
.eartag__tab{
  display:flex;align-items:center;gap:8px;background:var(--tag);
  padding:9px 14px;font-family:var(--f-mono);font-size:10px;font-weight:500;
  letter-spacing:.16em;text-transform:uppercase;color:#2A2115;
}
.eartag__tab::before{content:"";width:9px;height:9px;border-radius:50%;border:1.5px solid rgba(42,33,21,.55)}
.eartag__val{display:flex;align-items:center;padding:9px 16px;font-family:var(--f-mono);font-size:11px;color:var(--ink-soft);letter-spacing:.03em}
@media(max-width:520px){
  .eartag{flex-direction:column}
  .eartag__val{padding:10px 14px;border-top:1px solid var(--rule)}
}

/* ============================================================ STORY */
.story{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(34px,5vw,72px);align-items:center}
.story__figure{position:relative;margin-left:calc(var(--gut) * -1)}
.story__figure img{width:100%;aspect-ratio:4/3.1;object-fit:cover;filter:saturate(.86) contrast(1.03)}
.story__cap{
  font-family:var(--f-mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--ash);margin-top:12px;padding-left:2px;
}
.story__body{padding-block:6px}
.story__p{margin-top:20px;font-size:15.5px;line-height:1.95;color:var(--ink-soft)}
.story__quote{
  margin-top:34px;padding-left:22px;border-left:2px solid var(--seal);
  font-family:var(--f-disp);font-style:italic;font-weight:300;
  font-size:clamp(19px,2.5vw,26px);line-height:1.45;letter-spacing:-.01em;color:var(--sumi);
}
@media(max-width:900px){
  .story{grid-template-columns:1fr}
  .story__figure{margin-left:calc(var(--gut) * -1);margin-right:calc(var(--gut) * -1)}
}

/* ============================================================ COURSES (肉の品書き) */
.board{margin-top:48px;border-top:1px solid var(--rule-d)}
.board__row{padding:30px 0 32px;border-bottom:1px solid var(--rule-d)}
.board__row.is-featured{padding-left:clamp(14px,2vw,26px);border-left:2px solid var(--seal);background:linear-gradient(90deg,rgba(180,56,44,.09),rgba(180,56,44,0) 46%)}
.board__head{display:flex;align-items:flex-end;gap:0}
.board__name{font-family:var(--f-disp);font-weight:400;font-size:clamp(23px,3.2vw,34px);line-height:1.1;letter-spacing:-.015em}
.board__lead{
  flex:1;min-width:24px;height:8px;align-self:flex-end;margin:0 14px 7px;
  background-image:radial-gradient(circle,rgba(244,238,223,.42) 1px,transparent 1.3px);
  background-size:7px 8px;background-repeat:repeat-x;background-position:0 bottom;
}
.board__price{font-family:var(--f-mono);font-size:clamp(19px,2.6vw,25px);line-height:1;white-space:nowrap}
.board__per{display:block;font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--ash);margin-top:8px;text-align:right}
.board__meta{margin-top:12px;font-family:var(--f-mono);font-size:11px;letter-spacing:.12em;color:#AFA492}
.board__items{margin-top:16px;display:flex;flex-wrap:wrap;gap:6px 10px;max-width:74ch}
.board__items li{font-size:13.5px;color:#C3B8A6;line-height:1.7}
.board__items li:not(:last-child)::after{content:"·";margin-left:10px;color:var(--ash)}
@media(max-width:600px){
  .board__head{flex-wrap:wrap}
  .board__lead{display:none}
  .board__price{width:100%;margin-top:10px;font-size:22px}
  .board__per{text-align:left}
}

.drinks{
  margin-top:30px;display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px;
  border:1px dashed var(--rule-d);padding:18px 22px;
}
.drinks__k{font-family:var(--f-mono);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--tag)}
.drinks__n{font-size:14.5px;color:var(--paper)}
.drinks__p{font-family:var(--f-mono);font-size:15px;margin-left:auto;white-space:nowrap}
.drinks__note{flex-basis:100%;font-size:12.5px;color:var(--ash);line-height:1.7}
.menu__note{margin-top:26px;font-size:12.5px;color:var(--ash);line-height:1.8;max-width:62ch}

/* ============================================================ GALLERY */
.grid{margin-top:48px;display:grid;grid-template-columns:repeat(12,1fr);gap:clamp(10px,1.4vw,18px)}
.shot{position:relative;overflow:hidden;background:var(--paper-3)}
.shot img{width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.2,0,.2,1)}
.shot:hover img{transform:scale(1.04)}
.shot__cap{
  position:absolute;left:0;bottom:0;padding:8px 12px;
  font-family:var(--f-mono);font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--paper);background:rgba(14,11,9,.62);backdrop-filter:blur(3px);
}
.shot:nth-child(1){grid-column:span 5;aspect-ratio:4/5}
.shot:nth-child(2){grid-column:span 7;aspect-ratio:4/3}
.shot:nth-child(3){grid-column:span 7;aspect-ratio:16/10}
.shot:nth-child(4){grid-column:span 5;aspect-ratio:1/1}
.shot:nth-child(n+5){grid-column:span 6;aspect-ratio:3/2}
@media(max-width:760px){
  .grid{grid-template-columns:1fr}
  .shot:nth-child(n){grid-column:span 1;aspect-ratio:4/3}
}

/* ============================================================ ACCESS */
.access{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:clamp(34px,5vw,66px);align-items:start}
.rows{margin-top:38px;border-top:1px solid var(--rule-d)}
.rows__r{display:grid;grid-template-columns:118px 1fr;gap:16px;padding:16px 0;border-bottom:1px solid var(--rule-d)}
.rows__k{font-family:var(--f-mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--ash);padding-top:4px}
.rows__v{font-size:14.5px;line-height:1.8;color:var(--paper)}
.rows__v a{color:var(--paper);text-decoration:none;border-bottom:1px solid rgba(244,238,223,.35)}
.rows__v a:hover{border-color:var(--paper)}
.rows__v small{display:block;font-size:12.5px;color:var(--ash);margin-top:2px}
@media(max-width:560px){.rows__r{grid-template-columns:1fr;gap:4px}}
.access__cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.map{width:100%;aspect-ratio:4/3.4;border:1px solid var(--rule-d);filter:grayscale(1) contrast(.95) brightness(.92);transition:filter .4s ease}
.map:hover{filter:grayscale(0) contrast(1) brightness(1)}
.access--solo{grid-template-columns:minmax(0,1fr)!important;max-width:760px}
@media(max-width:900px){.access{grid-template-columns:1fr}.map{aspect-ratio:4/3}}

.stars{display:flex;align-items:center;gap:12px;margin-top:26px;font-family:var(--f-mono);font-size:12px;color:var(--paper)}
.stars__n{font-size:19px}
.stars__s{color:var(--tag);letter-spacing:.1em}
.stars a{color:var(--ash);text-decoration:none;border-bottom:1px solid transparent}
.stars a:hover{color:var(--paper);border-color:var(--rule-d)}

/* ============================================================ FOOTER */
.foot{background:var(--sumi-3);color:var(--paper);padding:64px 0 92px;border-top:1px solid var(--rule-d)}
.foot__top{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:26px}
.foot__mark{font-family:var(--f-script);font-size:38px;line-height:1}
.foot__note{font-family:var(--f-disp);font-style:italic;font-weight:300;font-size:16px;color:#B7AC9A;max-width:30ch}
.foot__links{display:flex;flex-wrap:wrap;gap:8px 10px;margin-top:38px;padding-top:26px;border-top:1px solid var(--rule-d)}
.foot__a{
  font-family:var(--f-mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;
  color:#B7AC9A;text-decoration:none;padding:10px 14px;border:1px solid var(--rule-d);
}
.foot__a:hover{color:var(--paper);border-color:rgba(244,238,223,.42)}
.foot__legal{margin-top:30px;font-family:var(--f-mono);font-size:10px;letter-spacing:.14em;color:#6E6558;line-height:2}
.foot__name{display:block;max-width:60ch;text-transform:none;letter-spacing:.04em}

/* ============================================================ LANG */
/* 既存 halal-wagyu-burger と同じ「右下・常時表示のピル」方式 */
.lang-switcher{
  position:fixed;right:12px;bottom:12px;z-index:200;
  display:flex;align-items:center;gap:2px;padding:4px;border-radius:100px;
  border:1px solid rgba(232,179,44,.5);background:rgba(14,11,9,.86);
  backdrop-filter:blur(12px);box-shadow:0 3px 18px rgba(0,0,0,.32);
}
.lang-switcher button{
  appearance:none;border:0;cursor:pointer;background:transparent;
  color:rgba(244,238,223,.62);font-family:var(--f-mono);font-size:10.5px;
  letter-spacing:.06em;padding:6px 10px;border-radius:100px;
  transition:background .2s ease,color .2s ease;white-space:nowrap;
}
.lang-switcher button:hover{color:var(--paper)}
.lang-switcher button.active{background:var(--tag);color:#2A2115}
@media(max-width:420px){.lang-switcher button{padding:6px 7px;font-size:10px}}

/* ============================================================ BANNER */
.banner{
  background:var(--seal);color:#FBF7EE;text-align:center;
  padding:10px 16px;font-family:var(--f-mono);font-size:10.5px;
  letter-spacing:.14em;line-height:1.6;
}

/* ============================================================ MOTION */
.rise{opacity:0;transform:translateY(22px);transition:opacity .8s cubic-bezier(.2,0,.2,1),transform .8s cubic-bezier(.2,0,.2,1)}
.rise.is-in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
  .rise{opacity:1;transform:none}
}
</style>
</head>
<body{% if store.banner %} style="--bar:38px"{% endif %}>
{%- if stores.gtm_id %}
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ stores.gtm_id }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
{%- endif %}

{%- if store.banner %}
<div class="banner">{{ store.banner }}</div>
{%- endif %}

<!-- ============================================================ TOPBAR -->
<header class="topbar" id="topbar">
  <a class="topbar__mark" href="#top">Farm to Table</a>
  <nav class="topbar__nav">
    {%- if store.courses.length %}<a class="topbar__link" href="#menu" data-i18n="nav_menu">Menu</a>{% endif %}
    <a class="topbar__link" href="#access" data-i18n="nav_access">Access</a>
    {%- if store.tablecheck_url %}
    <a class="btn btn--fill btn--sm" href="{{ store.tablecheck_url }}?utm_source=lp&utm_medium=referral" target="_blank" rel="noopener" data-ga-event="reserve_click" data-i18n="cta_reserve">Reserve a table</a>
    {%- else %}
    <a class="btn btn--fill btn--sm" href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click" data-i18n="cta_call">Call to reserve</a>
    {%- endif %}
  </nav>
</header>

<!-- ============================================================ HERO -->
<section class="hero" id="top">
  <div class="hero__media" aria-hidden="true">
    {%- for photo in store.hero_photos %}
    <img class="hero__shot{% if loop.first %} is-on{% endif %}" src="/{{ photo }}" alt="" {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
    {%- endfor %}
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__inner">
    <h1 class="mk">
      <span class="sr">{{ store.name }}</span>
      <span aria-hidden="true">
        <span class="mk__over">All-you-can-eat wagyu BBQ<br>by cattle farmers</span>
        <span class="mk__cjk" style="display:block">畜牧农场主经营的和牛烤肉自助</span>
        <span class="mk__word" style="display:block">Farm<span class="mk__mid"><span class="mk__seal"></span>to</span>Table</span>
        <span class="mk__cjk" style="display:block">畜産農家の和牛焼肉食べ放題</span>
        <span class="mk__rule"><span class="mk__est">est. 1962</span></span>
      </span>
    </h1>

    <p class="hero__sub" data-i18n="hero_sub">Sixty years in wagyu. Now we raise it ourselves — and you can eat as much as you like.</p>

    <div class="hero__cta">
      {%- if store.tablecheck_url %}
      <a class="btn btn--fill" href="{{ store.tablecheck_url }}?utm_source=lp&utm_medium=referral" target="_blank" rel="noopener" data-ga-event="reserve_click" data-i18n="cta_reserve">Reserve a table</a>
      {%- else %}
      <a class="btn btn--fill" href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click" data-i18n="cta_call">Call to reserve</a>
      {%- endif %}
      {%- if store.maps_link %}
      <a class="btn btn--ghost" href="{{ store.maps_link }}" target="_blank" rel="noopener" data-ga-event="map_click" data-i18n="cta_directions">Get directions</a>
      {%- endif %}
    </div>
  </div>

  <div class="hero__foot">
    <span>{{ store.area_label }}</span>
    {%- if store.hours %}<span class="hide-s">{{ store.hours }}{% if store.hours_note %} <span class="dot">·</span> {{ store.hours_note }}{% endif %}</span>{% endif %}
  </div>
</section>

<!-- ============================================================ TRACEABILITY -->
{%- if store.traceability %}
<section class="band band--paper">
  <div class="wrap">
    <div class="trace__head rise">
      <p class="eyebrow"><span data-i18n="trace_eyebrow">Traceability</span></p>
      <h2 class="h2" data-i18n="trace_title">We don't just buy the wagyu. We raise it.</h2>
    </div>

    <div class="ledger rise">
      <div class="ledger__cell">
        <p class="ledger__k" data-i18n="trace_1_k">Three generations</p>
        <p class="ledger__t" data-i18n="trace_1_t">Est. 1962</p>
        <p class="ledger__d" data-i18n="trace_1_d">Our founder began as a wagyu trader, walking Japan's cattle country to choose beef with his own eyes.</p>
      </div>
      <div class="ledger__cell">
        <p class="ledger__k" data-i18n="trace_2_k">Raised by us</p>
        <p class="ledger__t" data-i18n="trace_2_t">Our own farm</p>
        <p class="ledger__d" data-i18n="trace_2_d">Buying was never enough. Today we raise wagyu ourselves, one animal at a time.</p>
      </div>
      <div class="ledger__cell">
        <p class="ledger__k" data-i18n="trace_3_k">One cow, every cut</p>
        <p class="ledger__t" data-i18n="trace_3_t">Whole carcass</p>
        <p class="ledger__d" data-i18n="trace_3_d">We take the whole animal, so rare cuts reach your table instead of the wholesale market.</p>
      </div>
    </div>

    <div class="rise">
      <p class="eartag">
        <span class="eartag__tab" data-i18n="trace_tag_label">Individual ID</span>
        <span class="eartag__val" data-i18n="trace_tag_value">Ask your server for today's number</span>
      </p>
    </div>
  </div>
</section>
{%- endif %}

<!-- ============================================================ STORY -->
<section class="band band--paper" style="padding-top:0">
  <div class="wrap">
    <div class="story">
      <figure class="story__figure rise">
        <img src="/{{ store.farm_photo }}" alt="Farm to Table — {{ store.name_short }}" loading="lazy" decoding="async">
        <figcaption class="story__cap" data-i18n="story_caption">Our herd, at feed</figcaption>
      </figure>
      <div class="story__body rise">
        <p class="eyebrow"><span data-i18n="story_eyebrow">Since 1962</span></p>
        <h2 class="h2" data-i18n="story_title">From the farm, to your table.</h2>
        <p class="story__p" data-i18n="story_p1">In 1962 our founder set out across Japan's cattle country, meeting farmers one by one and choosing wagyu with his own eyes. That eye was handed down — through wholesale, through the butcher's counter, and finally into a restaurant of our own.</p>
        <p class="story__p" data-i18n="story_p2">But buying good beef was never enough. To serve wagyu we could truly stand behind, we had to raise it ourselves. So we did.</p>
        <blockquote class="story__quote" data-i18n="story_quote">We wanted to serve better wagyu than anyone could buy.</blockquote>
        <p class="story__p" data-i18n="story_p3">Sixty years of relationships, a trained eye, and a herd of our own — put together so you can eat wagyu until you are full, not until the bill says stop.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ COURSES -->
{%- if store.courses.length %}
<section class="band band--dark" id="menu">
  <div class="wrap">
    <div class="rise">
      <p class="eyebrow"><span data-i18n="menu_eyebrow">All you can eat</span></p>
      <h2 class="h2" data-i18n="menu_title">Three ways to eat wagyu.</h2>
    </div>

    <ol class="board rise">
      {%- for c in store.courses %}
      <li class="board__row{% if c.featured %} is-featured{% endif %}">
        <div class="board__head">
          <h3 class="board__name">{{ c.name }}</h3>
          <span class="board__lead" aria-hidden="true"></span>
          <p class="board__price">{{ c.price }}<small class="board__per" data-i18n="menu_per">per person</small></p>
        </div>
        <p class="board__meta">{{ c.name_jp }}{% if c.duration %} &nbsp;·&nbsp; {{ c.duration }}{% endif %}</p>
        {%- if c.items.length %}
        <ul class="board__items">
          {%- for i in c.items %}<li>{{ i }}</li>{% endfor %}
        </ul>
        {%- endif %}
      </li>
      {%- endfor %}
    </ol>

    {%- if store.drinks %}
    <div class="drinks rise">
      <span class="drinks__k" data-i18n="menu_drinks">Add free-flow drinks</span>
      <span class="drinks__n">{{ store.drinks.name_jp }}{% if store.drinks.duration %} · {{ store.drinks.duration }}{% endif %}</span>
      <span class="drinks__p">{{ store.drinks.price }}</span>
      {%- if store.drinks.note %}<span class="drinks__note">{{ store.drinks.note }}</span>{% endif %}
    </div>
    {%- endif %}

    <p class="menu__note rise" data-i18n="menu_note">Menu and prices may change without notice. Please tell our staff about any allergies.</p>
  </div>
</section>
{%- endif %}

<!-- ============================================================ GALLERY -->
{%- if store.gallery.length %}
<section class="band band--paper">
  <div class="wrap">
    <div class="rise">
      <p class="eyebrow"><span data-i18n="gallery_eyebrow">The room</span></p>
      <h2 class="h2" data-i18n="gallery_title">A grill at every table.</h2>
    </div>
    <div class="grid rise">
      {%- for g in store.gallery %}
      <figure class="shot">
        <img src="/{{ g.src }}" alt="{{ store.name_short }} — {{ g.caption }}" loading="lazy" decoding="async">
        {%- if g.caption %}<figcaption class="shot__cap">{{ g.caption }}</figcaption>{% endif %}
      </figure>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

<!-- ============================================================ ACCESS -->
<section class="band band--dark" id="access">
  <div class="wrap">
    <div class="access{% if not store.maps_embed %} access--solo{% endif %}">
      <div class="rise">
        <p class="eyebrow"><span data-i18n="access_eyebrow">Access</span></p>
        <h2 class="h2"><span data-i18n="access_title">Find us in</span> {{ store.city }}.</h2>

        <div class="rows">
          {%- if store.address_en %}
          <div class="rows__r">
            <span class="rows__k" data-i18n="lbl_address">Address</span>
            <span class="rows__v">{{ store.address_en }}</span>
          </div>
          {%- endif %}
          {%- if store.station_en %}
          <div class="rows__r">
            <span class="rows__k" data-i18n="lbl_access">Nearest station</span>
            <span class="rows__v">{{ store.station_en }}{% if store.station_note %}<small>{{ store.station_note }}</small>{% endif %}</span>
          </div>
          {%- endif %}
          {%- if store.hours %}
          <div class="rows__r">
            <span class="rows__k" data-i18n="lbl_hours">Hours</span>
            <span class="rows__v">{{ store.hours }}{% if store.hours_note or store.hours_special %}<small>{{ store.hours_note }}{% if store.hours_special %} · {{ store.hours_special }}{% endif %}</small>{% endif %}</span>
          </div>
          {%- endif %}
          {%- if store.tel_display %}
          <div class="rows__r">
            <span class="rows__k" data-i18n="lbl_tel">Phone</span>
            <span class="rows__v"><a href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click">{{ store.tel_display }}</a></span>
          </div>
          {%- endif %}
          {%- if store.seats %}
          <div class="rows__r">
            <span class="rows__k" data-i18n="lbl_seats">Seats</span>
            <span class="rows__v">{{ store.seats }}</span>
          </div>
          {%- endif %}
        </div>

        {%- if store.google_rating %}
        <p class="stars">
          <span class="stars__n">{{ store.google_rating }}</span>
          <span class="stars__s" aria-hidden="true">★★★★★</span>
          {%- if store.google_reviews_url %}
          <a href="{{ store.google_reviews_url }}" target="_blank" rel="noopener" data-ga-event="outbound_click"><span data-i18n="reviews_label">Google rating</span>{% if store.google_count %} ({{ store.google_count }}){% endif %}</a>
          {%- endif %}
        </p>
        {%- endif %}

        <div class="access__cta">
          {%- if store.tablecheck_url %}
          <a class="btn btn--fill" href="{{ store.tablecheck_url }}?utm_source=lp&utm_medium=referral" target="_blank" rel="noopener" data-ga-event="reserve_click" data-i18n="cta_reserve">Reserve a table</a>
          {%- else %}
          <a class="btn btn--fill" href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click" data-i18n="cta_call">Call to reserve</a>
          {%- endif %}
          {%- if store.maps_link %}
          <a class="btn btn--ghost" href="{{ store.maps_link }}" target="_blank" rel="noopener" data-ga-event="map_click" data-i18n="cta_directions">Get directions</a>
          {%- endif %}
        </div>
      </div>

      {%- if store.maps_embed %}
      <div class="rise">
        <iframe class="map" src="{{ store.maps_embed }}" title="{{ store.name_short }} map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </div>
      {%- endif %}
    </div>
  </div>
</section>

<!-- ============================================================ FOOTER -->
<footer class="foot">
  <div class="wrap">
    <div class="foot__top">
      <p class="foot__mark">Farm to Table</p>
      <p class="foot__note" data-i18n="footer_note">Wagyu raised by us, grilled by you.</p>
    </div>
    <nav class="foot__links">
      {%- if store.tablecheck_url %}
      <a class="foot__a" href="{{ store.tablecheck_url }}?utm_source=lp&utm_medium=referral" target="_blank" rel="noopener" data-ga-event="reserve_click">Reservation</a>
      {%- endif %}
      {%- if store.tel_display %}
      <a class="foot__a" href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click">Call</a>
      {%- endif %}
      {%- if store.maps_link %}
      <a class="foot__a" href="{{ store.maps_link }}" target="_blank" rel="noopener" data-ga-event="map_click">Maps</a>
      {%- endif %}
      {%- if store.instagram_url %}
      <a class="foot__a" href="{{ store.instagram_url }}" target="_blank" rel="noopener" data-ga-event="outbound_click">Instagram</a>
      {%- endif %}
    </nav>
    <p class="foot__legal">
      <span class="foot__name">{{ store.name }}</span>
      © {{ stores.founded }}–<span id="yr">2026</span> {{ stores.brand }}
    </p>
  </div>
</footer>

<!-- ============================================================ LANGUAGE -->
<div class="lang-switcher" role="group" aria-label="Language switcher">
  <button type="button" data-lang="en" class="active">EN</button>
  <button type="button" data-lang="ja">日本語</button>
  <button type="button" data-lang="zh">简体</button>
  <button type="button" data-lang="zt">繁體</button>
  <button type="button" data-lang="ko">한국어</button>
</div>

<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Restaurant",
  "name":"{{ store.name }}",
  "url":"{{ canonical }}",
  "image":"{{ stores.domain }}/{{ stores.og_image }}",
  "servesCuisine":["Yakiniku","Japanese BBQ","Wagyu"],
  "address":{"@type":"PostalAddress","streetAddress":"{{ store.address_en }}","addressLocality":"{{ store.city }}","addressCountry":"JP"}
  {%- if store.tel_display %},"telephone":"+{{ store.tel_raw }}"{% endif %}
  {%- if store.maps_link %},"hasMap":"{{ store.maps_link }}"{% endif %}
  {%- if store.tablecheck_url %},"acceptsReservations":"{{ store.tablecheck_url }}"{% endif %}
  {%- if store.google_rating %},"aggregateRating":{"@type":"AggregateRating","ratingValue":"{{ store.google_rating }}"{% if store.google_count %},"reviewCount":"{{ store.google_count }}"{% endif %}}{% endif %}
}
</script>

<script>
/* =====================================================================
   1) ヒーローのスライドショー
   ===================================================================== */
(function(){
  var shots = document.querySelectorAll('.hero__shot');
  if (shots.length < 2) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var i = 0;
  setInterval(function(){
    shots[i].classList.remove('is-on');
    i = (i + 1) % shots.length;
    shots[i].classList.add('is-on');
  }, 5200);
})();

/* =====================================================================
   2) スクロールで出るヘッダー / スクロール表示アニメーション
   ===================================================================== */
(function(){
  var bar = document.getElementById('topbar');
  var hero = document.querySelector('.hero');
  if (bar && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(function(es){
      bar.classList.toggle('is-on', !es[0].isIntersecting);
    }, {rootMargin: '-72% 0px 0px 0px'}).observe(hero);
  }
  var items = document.querySelectorAll('.rise');
  if (!('IntersectionObserver' in window)) {
    items.forEach(function(el){ el.classList.add('is-in'); });
    return;
  }
  var io = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
    });
  }, {rootMargin: '0px 0px -8% 0px', threshold: 0.06});
  items.forEach(function(el){ io.observe(el); });

  var yr = document.getElementById('yr');
  if (yr) yr.textContent = new Date().getFullYear();
})();

/* =====================================================================
   3) 計測 — data-ga-event="◯◯" を付けた要素をまとめて拾って dataLayer に push
      （店舗名・エリアなどのパラメータは GTM 側で URL から解決します）
   ===================================================================== */
document.addEventListener('click', function(ev){
  var el = ev.target.closest('[data-ga-event]');
  if (!el) return;
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ event: el.getAttribute('data-ga-event') });
});

