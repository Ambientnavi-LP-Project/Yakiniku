        {%- if store.tablecheck_url %}
        <a class="btn btn--fill" href="{{ reserve }}" target="_blank" rel="noopener" data-ga-event="reserve_click" data-i18n="cta_reserve_online">Reserve online</a>
        {%- endif %}
        {%- if store.tel_display %}
        <a class="btn btn--line" href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click" data-i18n="cta_call_long">Call to reserve</a>
        {%- endif %}
      </div>
      {%- if store.tel_display %}
      <p class="resv__tel"><a href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click">{{ store.tel_display }}</a>{% if store.hours %} &nbsp;&nbsp;{{ store.hours }}{% endif %}</p>
      {%- endif %}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════ GALLERY -->
{%- if store.gallery.length %}
<section class="sec">
  <div class="wrap">
    <div class="in rise">
      <p class="vlabel"><span data-i18n="gallery_label">The restaurant</span></p>
      <p class="hlabel" data-i18n="gallery_label">The restaurant</p>
      <h2 class="t">{{ store.city }}</h2>
      <div class="grid">
        {%- for g in store.gallery %}
        <figure class="shot">
          <img src="/{{ g.src }}" alt="{{ store.name_short }} — {{ g.caption }}" loading="lazy" decoding="async">
          {%- if g.caption %}<figcaption>{{ g.caption }}</figcaption>{% endif %}
        </figure>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>
{%- endif %}

<!-- ══════════════════════════════════════════ ACCESS -->
<section class="sec" id="access" style="padding-top:0">
  <div class="wrap">
    <div class="in rise">
      <p class="vlabel"><span data-i18n="access_label">Access</span></p>
      <p class="hlabel" data-i18n="access_label">Access</p>
      <div class="acc{% if not store.maps_embed %} acc--solo{% endif %}">
        <div>
          <h2 class="t"><span data-i18n="access_title">Find us in</span> {{ store.city }}.</h2>
          <div class="rows">
            <div class="rows__r">
              <span class="rows__k" data-i18n="lbl_name">Restaurant</span>
              <span class="rows__v">{{ store.name }}</span>
            </div>
            {%- if store.address_en %}
            <div class="rows__r">
              <span class="rows__k" data-i18n="lbl_address">Address</span>
              <span class="rows__v">{{ store.address_en }}</span>
            </div>
            {%- endif %}
            {%- if store.station_en %}
            <div class="rows__r">
              <span class="rows__k" data-i18n="lbl_station">Nearest station</span>
              <span class="rows__v">{{ store.station_en }}{% if store.station_note %}<small>{{ store.station_note }}</small>{% endif %}</span>
            </div>
            {%- endif %}
            {%- if store.hours %}
            <div class="rows__r">
              <span class="rows__k" data-i18n="lbl_hours">Hours</span>
              <span class="rows__v">{{ store.hours }}{% if store.hours_note or store.hours_special %}<small>{{ store.hours_note }}{% if store.hours_special %} · {{ store.hours_special }}{% endif %}</small>{% endif %}</span>
            </div>
            {%- endif %}
            {%- if store.tel_display %}
            <div class="rows__r">
              <span class="rows__k" data-i18n="lbl_tel">Phone</span>
              <span class="rows__v"><a href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click">{{ store.tel_display }}</a></span>
            </div>
            {%- endif %}
            {%- if store.seats %}
            <div class="rows__r">
              <span class="rows__k" data-i18n="lbl_seats">Seats</span>
