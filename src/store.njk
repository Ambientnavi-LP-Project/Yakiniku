  </div>
</footer>

<nav class="dock" aria-label="Reserve">
  {%- if store.tablecheck_url %}
  <a class="dock__r" href="{{ reserve }}" target="_blank" rel="noopener" data-ga-event="reserve_click" data-i18n="cta_reserve_long">Reserve a table</a>
  {%- endif %}
  {%- if store.tel_display %}
  <a class="dock__t" href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click" data-i18n="cta_call">Call</a>
  {%- endif %}
</nav>

<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Restaurant",
  "name":"{{ store.name }}",
  "url":"{{ canonical }}",
  "image":"{{ stores.domain }}/{{ stores.og_image }}",
  "servesCuisine":["Yakiniku","Japanese BBQ","Wagyu"],
  "address":{"@type":"PostalAddress","streetAddress":"{{ store.address_en }}","addressLocality":"{{ store.city }}","addressCountry":"JP"}
  {%- if store.tel_display %},"telephone":"+{{ store.tel_raw }}"{% endif %}
  {%- if store.maps_link %},"hasMap":"{{ store.maps_link }}"{% endif %}
  {%- if store.tablecheck_url %},"acceptsReservations":"{{ store.tablecheck_url }}"{% endif %}
  {%- if store.google_rating %},"aggregateRating":{"@type":"AggregateRating","ratingValue":"{{ store.google_rating }}"{% if store.google_count %},"reviewCount":"{{ store.google_count }}"{% endif %}}{% endif %}
}
</script>

<script>
/* 帯＋ヘッダーの高さを実測してヒーローの高さに反映（翻訳で行数が変わっても崩れない） */
(function(){
  var banner = document.querySelector('.banner');
  var head = document.querySelector('.head');
  function setStack(){
    var h = (banner ? banner.offsetHeight : 0) + (head ? head.offsetHeight : 0);
    document.documentElement.style.setProperty('--stack', h + 'px');
  }
  setStack();
  window.addEventListener('resize', setStack);
  window.addEventListener('load', setStack);
  document.addEventListener('langchange', setStack);
})();

/* ヒーローのクロスフェード */
(function(){
  var shots = document.querySelectorAll('.hero__shot');
  if (shots.length < 2) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var i = 0;
  setInterval(function(){
    shots[i].classList.remove('is-on');
    i = (i + 1) % shots.length;
    shots[i].classList.add('is-on');
  }, 6000);
})();

/* スクロール表示 */
(function(){
  var items = document.querySelectorAll('.rise');
  if (!('IntersectionObserver' in window)) {
    items.forEach(function(el){ el.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      });
    }, {rootMargin: '0px 0px -6% 0px', threshold: 0.04});
    items.forEach(function(el){ io.observe(el); });
  }
  var yr = document.getElementById('yr');
  if (yr) yr.textContent = new Date().getFullYear();
})();
</script>

<script>
  /* === クリック計測（data-ga-event → dataLayer → GTM → GA4）===
     計測したい要素に data-ga-event="イベント名" を付けるだけ。
     店舗・チャネル等のパラメータはコード側で組み立てず、GTM側でURLから解決する。 */
  window.dataLayer = window.dataLayer || [];
  document.addEventListener('click', function (e) {
    var el = e.target.closest('[data-ga-event]');
    if (!el) return;
    window.dataLayer.push({ event: el.getAttribute('data-ga-event') });
  }, true);
</script>

