---
pagination:
  data: stores.stores
  size: 1
  alias: store
permalink: "/{{ store.region }}/{{ store.slug }}/index.html"
---
{#- 社内名称: {{ store.internal_name }} -#}
{%- set desc = "All-you-can-eat wagyu yakiniku BBQ in " + store.city + ". Run by cattle farmers since 1962 — we raise our own wagyu. " + store.name -%}
{%- set canonical = stores.domain + "/" + store.region + "/" + store.slug + "/" -%}
{#- 予約リンク。TableCheck 側で「公式サイト経由」と、どのボタンから来たかが分かるようにする -#}
{%- set utm = "?utm_source=official-site&utm_medium=website&utm_campaign=" + store.region + "-" + store.slug -%}
{%- set reserve = store.tablecheck_url + utm -%}
<!doctype html>
<html lang="en" data-store="{{ store.region }}-{{ store.slug }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ store.name }}</title>
<meta name="description" content="{{ desc }}">
<link rel="canonical" href="{{ canonical }}">
<meta property="og:type" content="restaurant.restaurant">
<meta property="og:title" content="{{ store.name }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ stores.domain }}/{{ stores.og_image }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0B0908">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,200..500;1,9..144,200..400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

{%- if stores.gtm_id %}
<script>window.dataLayer=window.dataLayer||[];(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','{{ stores.gtm_id }}');</script>
{%- else %}
<script>window.dataLayer=window.dataLayer||[];</script>
{%- endif %}

<style>
/* ═══════════════════════════════════════════════════════════════
   Farm to Table

   ロゴは「生成りの紙に墨」。ページはそれを反転させ、墨を地に、
   生成りを文字にしている。店内が炭火の暗い部屋であること、
   料理写真が黒バックであることに合わせた反転。
   牧場のセクションだけ生成りに戻り、昼の光になる。
   ═══════════════════════════════════════════════════════════════ */
:root{
  --ink:#0B0908; --ink-2:#131010; --ink-3:#1C1714;
  --paper:#F6EFDD; --paper-2:#EBE1C9;
  --seal:#B4382C; --seal-d:#992D22;
  --brass:#9C8055;
  --stone:#8B8074;
  --hair:rgba(246,239,221,.14);
  --hair-2:rgba(11,9,8,.16);

  --f-disp:"Fraunces",Georgia,"Times New Roman",serif;
  --f-mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  --f-body:-apple-system,BlinkMacSystemFont,"Segoe UI","Hiragino Sans",
    "Noto Sans JP","PingFang SC","Microsoft YaHei",
    "Apple SD Gothic Neo","Malgun Gothic",sans-serif;

  --wrap:1240px;
  --gut:clamp(20px,5vw,64px);
  --band:clamp(84px,11vw,172px);
  --rail:0px;
  --head:56px;
  --dock:0px;
}
@media(min-width:1120px){ :root{ --rail:104px; --head:0px } }
@media(max-width:760px){ :root{ --dock:55px } }

*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{
  margin:0;padding-left:var(--rail);background:var(--ink);color:var(--paper);
  font-family:var(--f-body);font-size:15px;line-height:1.9;
  letter-spacing:.012em;-webkit-font-smoothing:antialiased;overflow-x:hidden;
}
img,iframe{max-width:100%;display:block}
a{color:inherit}
h1,h2,h3,p,ul,ol,figure,blockquote{margin:0;padding:0}
ul,ol{list-style:none}
::selection{background:var(--seal);color:var(--paper)}
:focus-visible{outline:1px solid var(--paper);outline-offset:4px}
.sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}

.wrap{width:100%;max-width:var(--wrap);margin-inline:auto;padding-inline:var(--gut)}
.sec{position:relative;padding-block:var(--band)}
.sec--light{background:var(--paper);color:var(--ink)}

/* 節のラベルは左の余白に縦書きで走らせる */
.in{position:relative}
.vlabel{display:none}
.hlabel{font-family:var(--f-mono);font-size:9.5px;font-weight:500;letter-spacing:.34em;text-transform:uppercase;color:var(--stone);padding-bottom:22px}
@media(min-width:1080px){
  .in{padding-left:96px}
  .hlabel{display:none}
  .vlabel{
    display:flex;align-items:center;gap:18px;position:absolute;left:0;top:4px;
    writing-mode:vertical-rl;font-family:var(--f-mono);font-size:9.5px;font-weight:500;
    letter-spacing:.38em;text-transform:uppercase;color:var(--stone);
  }
  .vlabel::after{content:"";width:1px;height:64px;background:var(--brass);opacity:.65}
}

h2.t{font-family:var(--f-disp);font-optical-sizing:auto;font-weight:300;
  font-size:clamp(30px,5.2vw,62px);line-height:1.06;letter-spacing:-.028em;max-width:17ch}
.lede{font-size:clamp(15px,1.5vw,16.5px);line-height:1.95;color:#BFB4A2;max-width:54ch}
.sec--light .lede{color:#584E42}

/* ── buttons ─────────────────────────────────────────── */
.btn{display:inline-flex;align-items:center;justify-content:center;
  font-family:var(--f-mono);font-size:10.5px;font-weight:500;letter-spacing:.24em;
  text-transform:uppercase;text-decoration:none;padding:17px 32px;border:1px solid transparent;
  transition:background .25s ease,color .25s ease,border-color .25s ease;white-space:nowrap;cursor:pointer}
.btn--fill{background:var(--seal);color:#F7F1E6;border-color:var(--seal)}
.btn--fill:hover{background:var(--seal-d);border-color:var(--seal-d)}
.btn--line{border-color:rgba(246,239,221,.32);color:var(--paper)}
.btn--line:hover{border-color:var(--paper)}
.sec--light .btn--line{border-color:rgba(11,9,8,.3);color:var(--ink)}
.sec--light .btn--line:hover{border-color:var(--ink);background:var(--ink);color:var(--paper)}
.btn--sm{padding:10px 17px;font-size:9.5px;letter-spacing:.18em}

/* ═══════════════════════ SIDE RAIL（デスクトップ） ═══════════════════════ */
.rail{display:none}
@media(min-width:1120px){
  .rail{
    position:fixed;left:0;top:0;bottom:0;width:var(--rail);z-index:80;
    display:flex;flex-direction:column;align-items:center;
    background:var(--ink);border-right:1px solid var(--hair);
  }
  .rail__logo{display:block;padding:22px 0 0;width:66px}
  .rail__logo img{width:100%;height:auto}
  .rail__nav{display:flex;flex-direction:column;align-items:center;gap:2px;margin-block:auto;padding-block:14px}
  .rail__a{
    position:relative;font-family:var(--f-mono);font-size:9px;font-weight:500;
    letter-spacing:.2em;text-transform:uppercase;color:rgba(246,239,221,.45);
    text-decoration:none;padding:9px 4px;transition:color .25s ease;
  }
  .rail__a::before{
    content:"";position:absolute;left:-2px;top:50%;width:12px;height:1px;
    background:var(--seal);transform:translateY(-50%) scaleX(0);transform-origin:left;
    transition:transform .3s cubic-bezier(.2,0,.2,1);
  }
  .rail__a:hover{color:var(--paper)}
  .rail__a.is-here{color:var(--paper)}
  .rail__a.is-here::before{transform:translateY(-50%) scaleX(1)}
  /* スクロール進捗 */
  .rail__bar{position:absolute;right:-1px;top:0;width:1px;background:var(--seal);height:0}
}

/* ═══════════════════════ BANNER / HEADER（モバイル） ═══════════════════════ */
.head{
  position:fixed;top:0;left:var(--rail);right:0;z-index:70;height:var(--head);
  display:flex;align-items:center;justify-content:space-between;gap:14px;
  padding-inline:var(--gut);
  background:transparent;border-bottom:1px solid transparent;
  transition:background .45s ease,border-color .45s ease;
}
.head.is-solid{background:rgba(11,9,8,.9);backdrop-filter:blur(14px) saturate(140%);border-bottom-color:var(--hair)}
.head__mark{display:flex;align-items:center;padding-block:6px}
.head__mark img{height:24px;width:auto;filter:drop-shadow(0 2px 14px rgba(0,0,0,.7))}
.head__right{display:flex;align-items:center;gap:clamp(12px,2vw,26px);margin-left:auto}
.lang{display:flex;align-items:center}
.lang button{
  appearance:none;border:0;background:transparent;cursor:pointer;position:relative;
  font-family:var(--f-mono);font-size:10px;font-weight:500;letter-spacing:.12em;
  color:rgba(246,239,221,.62);padding:8px 0;margin-left:14px;white-space:nowrap;
  transition:color .2s ease;text-shadow:0 1px 10px rgba(0,0,0,.6);
}
.lang button::after{content:"";position:absolute;left:0;right:0;bottom:2px;height:1px;background:var(--paper);transform:scaleX(0);transform-origin:left;transition:transform .25s cubic-bezier(.2,0,.2,1)}
.lang button:first-child{margin-left:0}
.lang button:hover,.lang button.active{color:var(--paper)}
.lang button.active::after{transform:scaleX(1)}
@media(min-width:1120px){ :root{--head:76px} .head__mark{display:none} }
@media(max-width:560px){
  .head{--head:54px;padding-inline:16px;gap:8px}
  .head__mark img{height:19px}
  .lang button{margin-left:9px;font-size:9.5px;letter-spacing:.02em}
  .head .btn--sm{padding:9px 11px;font-size:9px;letter-spacing:.1em}
}
@media(max-width:360px){ .head__mark{display:none} }

@media(max-width:560px){
  .head{--head:52px;padding-inline:16px;gap:10px}
  .head__mark img{height:21px}
  .lang button{margin-left:12px;letter-spacing:.06em}
}

/* ═══════════════════════ 視差（背景がゆっくり動く） ═══════════════════════ */
.px{position:relative;overflow:hidden;background:#000}
.px__bg{position:absolute;inset:-10% 0;width:100%;height:120%;object-fit:cover;will-change:transform}
.px__scrim{position:absolute;inset:0}

/* ═══════════════════════ HERO ═══════════════════════ */
.hero{
  position:relative;overflow:hidden;background:#000;
  min-height:calc(100svh - var(--dock,0px));
  display:flex;flex-direction:column;justify-content:flex-end;
}
.hero__media{position:absolute;inset:-6% 0;height:112%}
.hero__shot{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
  opacity:0;transition:opacity 1.8s ease;animation:drift 28s ease-in-out infinite alternate}
.hero__shot.is-on{opacity:1}
@keyframes drift{from{transform:scale(1)}to{transform:scale(1.07) translate3d(-.8%,-.8%,0)}}
.hero__scrim{position:absolute;inset:0;
  background:
    /* 文字が乗るのは下端だけ。写真の上2/3はほぼ素のまま見せる */
    radial-gradient(62% 46% at 14% 88%,rgba(6,5,4,.5) 0%,rgba(6,5,4,.18) 52%,rgba(6,5,4,0) 80%),
    linear-gradient(180deg,rgba(6,5,4,.3) 0%,rgba(6,5,4,0) 16%,rgba(6,5,4,0) 46%,rgba(6,5,4,.3) 74%,rgba(6,5,4,.66) 100%);
}
.hero__in{position:relative;padding-block:0 30px;max-width:calc(var(--wrap))}
.hero__badge{
  display:inline-block;border:1px solid rgba(180,56,44,.85);
  padding:8px 15px;font-family:var(--f-mono);font-size:9px;font-weight:500;
  letter-spacing:.32em;text-transform:uppercase;color:var(--paper);
  background:rgba(11,9,8,.3);backdrop-filter:blur(2px);
}
.mk{display:block;width:clamp(196px,21vw,290px);height:auto;margin-top:18px;
  filter:drop-shadow(0 3px 22px rgba(0,0,0,.7))}
/* 正式店名。ヒーローで最も大きく読ませる要素 */
.hero__name{
  margin-top:20px;max-width:24ch;
  font-family:var(--f-disp);font-weight:300;font-size:clamp(21px,2.9vw,36px);
  line-height:1.28;letter-spacing:-.014em;color:#F8F2E4;
  text-shadow:0 2px 22px rgba(6,5,4,.92),0 1px 4px rgba(6,5,4,.7);
}
.hero__cta{display:flex;flex-wrap:wrap;align-items:center;gap:14px 24px;margin-top:26px}
.hero__foot{
  position:relative;margin-top:clamp(22px,3.5vw,38px);border-top:1px solid var(--hair);
  padding:15px var(--gut) calc(15px + env(safe-area-inset-bottom));
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  font-family:var(--f-mono);font-size:9.5px;letter-spacing:.24em;text-transform:uppercase;
  color:rgba(246,239,221,.72);background:linear-gradient(180deg,rgba(6,5,4,0),rgba(6,5,4,.5));
}
.hero__foot span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
@media(max-width:640px){.hero__foot{font-size:9px;letter-spacing:.14em}}

/* スクロールの合図 */
.cue{position:absolute;right:var(--gut);bottom:96px;z-index:2;display:flex;flex-direction:column;align-items:center;gap:12px;
  font-family:var(--f-mono);font-size:8.5px;letter-spacing:.3em;text-transform:uppercase;color:rgba(246,239,221,.5);
  writing-mode:vertical-rl}
.cue::after{content:"";width:1px;height:54px;background:linear-gradient(180deg,rgba(246,239,221,.5),rgba(246,239,221,0));
  animation:cue 2.4s ease-in-out infinite}
@keyframes cue{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}
  51%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
@media(max-width:900px){.cue{display:none}}

/* ═══════════════════════ STATEMENT（視差の上に一文） ═══════════════════════ */
.say{min-height:78svh;display:flex;align-items:center}
.say .px__scrim{background:linear-gradient(90deg,rgba(6,5,4,.9) 0%,rgba(6,5,4,.66) 44%,rgba(6,5,4,.3) 100%)}
.say__in{position:relative;width:100%;padding-block:clamp(70px,9vw,120px)}
.say q{display:block;quotes:none;font-family:var(--f-disp);font-style:italic;font-weight:200;
  font-size:clamp(25px,4.4vw,54px);line-height:1.2;letter-spacing:-.025em;max-width:20ch;color:var(--paper)}
.say__by{margin-top:26px;font-family:var(--f-mono);font-size:9.5px;letter-spacing:.3em;text-transform:uppercase;color:#AFA492}

/* ═══════════════════════ STORY ═══════════════════════ */
.story__lead{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(30px,4vw,58px)}
@media(min-width:900px){.story__lead{grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);align-items:end}}
.story__p{margin-top:22px;font-size:15px;line-height:2.05;color:#584E42;max-width:54ch}
.story__q{margin:clamp(46px,6vw,86px) 0 0;font-family:var(--f-disp);font-style:italic;font-weight:200;
  font-size:clamp(24px,3.8vw,46px);line-height:1.25;letter-spacing:-.022em;color:var(--ink);max-width:19ch}
.story__q::before{content:"";display:block;width:46px;height:1px;background:var(--seal);margin-bottom:24px}

/* 全幅の写真 */
.bleed{position:relative;width:calc(100vw - var(--rail));margin-left:calc(50% - (100vw - var(--rail))/2);margin-block:clamp(48px,7vw,104px)}
.bleed img{width:100%;height:clamp(230px,42vw,560px);object-fit:cover}
.bleed figcaption{max-width:var(--wrap);margin:14px auto 0;padding-inline:var(--gut);
  font-family:var(--f-mono);font-size:9.5px;letter-spacing:.26em;text-transform:uppercase;color:#8B8074}

/* ═══════════════════════ BRAND MARK ═══════════════════════ */
.plate{display:block;margin-inline:auto;width:clamp(250px,32vw,392px);height:auto}

/* ═══════════════════════ STRENGTHS ═══════════════════════ */
.str{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(34px,5vw,72px)}
@media(min-width:960px){.str{grid-template-columns:minmax(0,.78fr) minmax(0,1fr);align-items:start}}
.str__fig img{width:100%;aspect-ratio:4/4.5;object-fit:cover}
.str__list{border-top:1px solid var(--hair-2)}
.str__row{display:grid;grid-template-columns:minmax(0,1fr);gap:6px;padding:26px 0;border-bottom:1px solid var(--hair-2)}
@media(min-width:620px){.str__row{grid-template-columns:44px 130px minmax(0,1fr);gap:20px;align-items:baseline}}
.str__n{font-family:var(--f-mono);font-size:11px;color:var(--seal);letter-spacing:.06em}
.str__k{font-family:var(--f-mono);font-size:9.5px;font-weight:500;letter-spacing:.26em;text-transform:uppercase;color:#8B8074}
.str__t{font-family:var(--f-disp);font-weight:300;font-size:clamp(21px,2.6vw,29px);line-height:1.2;letter-spacing:-.02em;color:var(--ink)}
.str__d{margin-top:8px;font-size:14px;line-height:1.95;color:#584E42;max-width:44ch}

/* ═══════════════════════ WAGYU（写真主役） ═══════════════════════ */
.duo{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(14px,2vw,26px);margin-top:clamp(38px,5vw,64px)}
@media(min-width:880px){.duo{grid-template-columns:1.25fr 1fr;align-items:end}}
.duo figure{overflow:hidden}
.duo img{width:100%;height:100%;object-fit:cover;transition:transform 1s cubic-bezier(.2,0,.2,1)}
.duo figure:hover img{transform:scale(1.04)}
.duo figure:nth-child(1) img{aspect-ratio:4/3}
.duo figure:nth-child(2) img{aspect-ratio:1/1}

/* ═══════════════════════ COURSES ═══════════════════════ */
.board{margin-top:clamp(38px,5vw,64px);border-top:1px solid var(--hair)}
.board__row{padding:32px 0 34px;border-bottom:1px solid var(--hair);position:relative}
.board__row.is-featured::before{content:"";position:absolute;left:calc(var(--gut)*-1);top:-1px;bottom:-1px;width:2px;background:var(--seal)}
@media(min-width:1080px){.board__row.is-featured::before{left:-40px}}
.board__n{font-family:var(--f-mono);font-size:11px;color:var(--seal);letter-spacing:.06em}
.board__head{display:flex;align-items:baseline;gap:0;margin-top:8px}
.board__name{font-family:var(--f-disp);font-weight:300;font-size:clamp(24px,3.4vw,38px);line-height:1.1;letter-spacing:-.024em}
.board__lead{flex:1;min-width:24px;height:1px;margin:0 20px 8px;background:var(--hair)}
.board__price{font-family:var(--f-mono);font-size:clamp(17px,2.1vw,21px);line-height:1;white-space:nowrap}
.board__per{display:block;font-size:9px;letter-spacing:.24em;text-transform:uppercase;color:var(--stone);margin-top:9px;text-align:right}
.board__meta{margin-top:11px;font-family:var(--f-mono);font-size:10.5px;letter-spacing:.16em;color:#9A8F7E}
.board__optk{margin-top:18px;font-family:var(--f-mono);font-size:9px;letter-spacing:.28em;text-transform:uppercase;color:var(--stone)}
.board__opts{margin-top:11px;display:flex;flex-wrap:wrap;gap:9px}
.board__opts li{
  display:inline-flex;align-items:center;gap:8px;
  border:1px solid var(--hair);padding:9px 15px;
  font-family:var(--f-mono);font-size:10px;letter-spacing:.14em;
  text-transform:uppercase;color:#CFC5B4;
}
.board__opts li::before{content:"+";color:var(--seal);font-size:12px;line-height:1}
.board__items{margin-top:14px;display:flex;flex-wrap:wrap;gap:5px 9px;max-width:72ch}
.board__items li{font-size:13.5px;color:#BFB4A2;line-height:1.7}
.board__items li:not(:last-child)::after{content:"/";margin-left:9px;color:rgba(246,239,221,.25)}
@media(max-width:600px){
  .board__head{flex-wrap:wrap}.board__lead{display:none}
  .board__price{width:100%;margin-top:12px;font-size:19px}.board__per{text-align:left}
}
.drinks{margin-top:32px;display:flex;flex-wrap:wrap;align-items:baseline;gap:10px 22px;padding-top:6px}
.drinks__k{font-family:var(--f-mono);font-size:9.5px;letter-spacing:.26em;text-transform:uppercase;color:var(--stone)}
.drinks__n{font-size:14.5px}
.drinks__p{font-family:var(--f-mono);font-size:15px;margin-left:auto;white-space:nowrap}
.drinks__note{flex-basis:100%;font-size:12.5px;color:var(--stone);line-height:1.75}
.note{margin-top:28px;font-size:12.5px;color:var(--stone);line-height:1.85;max-width:58ch}
.after{margin-top:clamp(38px,5vw,58px);display:flex;flex-wrap:wrap;align-items:center;gap:16px 26px}
.after p{font-family:var(--f-mono);font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--stone)}

/* ═══════════════════════ RESERVATION（視差） ═══════════════════════ */
.resv .px__scrim{background:linear-gradient(92deg,rgba(6,5,4,.94) 0%,rgba(6,5,4,.74) 46%,rgba(6,5,4,.42) 100%)}
.resv__in{position:relative;padding-block:clamp(80px,10vw,140px)}
.resv__t{font-family:var(--f-disp);font-weight:300;font-size:clamp(28px,4.6vw,54px);line-height:1.08;letter-spacing:-.028em;margin-top:22px;max-width:14ch}
.resv__d{margin-top:20px;max-width:42ch;font-size:15px;line-height:1.95;color:#BFB4A2}
.resv__cta{margin-top:34px;display:flex;flex-wrap:wrap;gap:14px}
.resv__tel{margin-top:24px;font-family:var(--f-mono);font-size:11px;letter-spacing:.12em;color:var(--stone)}
.resv__tel a{color:var(--paper);text-decoration:none;border-bottom:1px solid rgba(246,239,221,.3)}

/* ═══════════════════════ GALLERY ═══════════════════════ */
.grid{margin-top:clamp(38px,5vw,60px);display:grid;grid-template-columns:repeat(12,1fr);gap:clamp(10px,1.2vw,16px)}
.shot{position:relative;overflow:hidden;background:var(--ink-3)}
.shot img{width:100%;height:100%;object-fit:cover;transition:transform 1s cubic-bezier(.2,0,.2,1)}
.shot:hover img{transform:scale(1.045)}
.shot figcaption{position:absolute;left:14px;bottom:12px;font-family:var(--f-mono);font-size:9px;
  letter-spacing:.24em;text-transform:uppercase;color:var(--paper);text-shadow:0 1px 12px rgba(0,0,0,.9)}
.shot:nth-child(1){grid-column:span 7;aspect-ratio:4/2.9}
.shot:nth-child(2){grid-column:span 5;aspect-ratio:4/4.6}
.shot:nth-child(3){grid-column:span 5;aspect-ratio:1/1}
.shot:nth-child(4){grid-column:span 7;aspect-ratio:4/2.9}
.shot:nth-child(n+5){grid-column:span 6;aspect-ratio:3/2}
@media(max-width:760px){.grid{grid-template-columns:1fr}.shot:nth-child(n){grid-column:span 1;aspect-ratio:4/3}}

/* ═══════════════════════ ACCESS ═══════════════════════ */
.acc{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(34px,5vw,64px);align-items:start}
@media(min-width:940px){.acc{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
.acc--solo{grid-template-columns:minmax(0,1fr)!important;max-width:720px}
.rows{margin-top:clamp(30px,4vw,48px);border-top:1px solid var(--hair)}
.rows__r{display:grid;grid-template-columns:minmax(0,1fr);gap:5px;padding:17px 0;border-bottom:1px solid var(--hair)}
@media(min-width:520px){.rows__r{grid-template-columns:112px minmax(0,1fr);gap:20px}}
.rows__k{font-family:var(--f-mono);font-size:9.5px;letter-spacing:.24em;text-transform:uppercase;color:var(--stone);padding-top:5px}
.rows__v{font-size:14.5px;line-height:1.8}
.rows__v a{text-decoration:none;border-bottom:1px solid rgba(246,239,221,.3)}
.rows__v a:hover{border-color:var(--paper)}
.rows__v small{display:block;font-size:12.5px;color:var(--stone);margin-top:2px}
.acc__cta{display:flex;flex-wrap:wrap;gap:14px;margin-top:32px}
.map{width:100%;aspect-ratio:1/1;border:1px solid var(--hair);filter:grayscale(1) invert(.92) contrast(.85);transition:filter .5s ease}
.map:hover{filter:none}
@media(max-width:940px){.map{aspect-ratio:4/3}}
.stars{display:flex;align-items:baseline;gap:12px;margin-top:26px;font-family:var(--f-mono);font-size:11px}
.stars__n{font-size:19px}
.stars__s{color:var(--brass);letter-spacing:.14em}
.stars a{color:var(--stone);text-decoration:none}
.stars a:hover{color:var(--paper)}

/* ═══════════════════════ FOOTER ═══════════════════════ */
.foot{border-top:1px solid var(--hair);padding:clamp(52px,6vw,76px) 0 44px}
.foot__mark{display:block;width:clamp(180px,22vw,240px);height:auto}
.foot__links{display:flex;flex-wrap:wrap;gap:0 30px;margin-top:34px;padding-top:26px;border-top:1px solid var(--hair)}
.foot__a{font-family:var(--f-mono);font-size:9.5px;letter-spacing:.26em;text-transform:uppercase;
  color:var(--stone);text-decoration:none;padding-block:9px;border-bottom:1px solid transparent;
  transition:color .2s ease,border-color .2s ease}
.foot__a:hover{color:var(--paper);border-color:var(--hair)}
.foot__legal{margin-top:30px;font-family:var(--f-mono);font-size:9.5px;letter-spacing:.14em;color:#5C554B;line-height:2.1}
.foot__name{display:block;max-width:64ch;text-transform:none;letter-spacing:.05em;margin-bottom:6px}

/* ═══════════════════════ MOBILE DOCK ═══════════════════════ */
.dock{position:fixed;left:0;right:0;bottom:0;z-index:65;display:none;
  padding-bottom:env(safe-area-inset-bottom);border-top:1px solid rgba(246,239,221,.2);
  box-shadow:0 -10px 30px rgba(0,0,0,.4)}
.dock a{flex:1;display:flex;align-items:center;justify-content:center;
  font-family:var(--f-mono);font-size:10.5px;font-weight:500;letter-spacing:.2em;
  text-transform:uppercase;text-decoration:none;padding:17px 8px}
.dock__r{background:var(--seal);color:#F7F1E6}
.dock__t{background:var(--ink-3);color:var(--paper);flex:0 0 33%;border-left:1px solid rgba(246,239,221,.16)}
@media(max-width:760px){.dock{display:flex}.foot{padding-bottom:100px}}

/* ═══════════════════════ MOTION ═══════════════════════ */
.rise{opacity:0;transform:translateY(24px);transition:opacity .9s cubic-bezier(.2,0,.2,1),transform .9s cubic-bezier(.2,0,.2,1)}
.rise.is-in{opacity:1;transform:none}
.rise[data-d="1"]{transition-delay:.09s}
.rise[data-d="2"]{transition-delay:.18s}
.rise[data-d="3"]{transition-delay:.27s}
/* 画像は下から拭き上げるように出す */
.wipe > img{clip-path:inset(0 0 100% 0);transition:clip-path 1.15s cubic-bezier(.16,1,.3,1)}
.wipe.is-in > img{clip-path:inset(0 0 0 0)}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
  .rise{opacity:1;transform:none}
  .wipe > img{clip-path:none}
}
</style>
</head>
<body>
{%- if stores.gtm_id %}
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ stores.gtm_id }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
{%- endif %}

<!-- ══════════════════════════════════════════ SIDE RAIL -->
<aside class="rail">
  <a class="rail__logo" href="#top" aria-label="Farm to Table"><img src="/{{ stores.logo_wordmark }}" width="996" height="276" alt="Farm to Table"></a>
  <nav class="rail__nav" aria-label="Sections">
    <a class="rail__a" href="#story" data-i18n="nav_story">Story</a>
    {%- if store.courses.length %}<a class="rail__a" href="#menu" data-i18n="nav_menu">Menu</a>{% endif %}
    <a class="rail__a" href="#room" data-i18n="nav_room">Room</a>
    <a class="rail__a" href="#access" data-i18n="nav_access">Access</a>
  </nav>
  <span class="rail__bar" id="railBar" aria-hidden="true"></span>
</aside>

<header class="head" id="head">
  <a class="head__mark" href="#top" aria-label="Farm to Table"><img src="/{{ stores.logo_wordmark }}" width="996" height="276" alt="Farm to Table"></a>
  <div class="head__right">
    <div class="lang" role="group" aria-label="Language">
      <button type="button" data-lang="en" class="active">EN</button>
      <button type="button" data-lang="zh">简体</button>
      <button type="button" data-lang="zt">繁體</button>
      <button type="button" data-lang="ko">한국어</button>
    </div>
    {%- if store.tablecheck_url %}
    <a class="btn btn--fill btn--sm" href="{{ reserve }}&utm_content=header" target="_blank" rel="noopener" data-ga-event="reserve_click" data-i18n="cta_reserve">Reserve</a>
    {%- else %}
    <a class="btn btn--fill btn--sm" href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click" data-i18n="cta_call">Call</a>
    {%- endif %}
  </div>
</header>

<!-- ══════════════════════════════════════════ HERO -->
<section class="hero" id="top">
  <div class="hero__media" aria-hidden="true" data-parallax>
    {%- for photo in store.hero_photos %}
    <img class="hero__shot{% if loop.first %} is-on{% endif %} px__bg" src="/{{ photo }}" alt="" {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
    {%- endfor %}
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <p class="cue" aria-hidden="true"><span data-i18n="scroll">Scroll</span></p>

  <div class="hero__in wrap">
    <p class="hero__badge rise" data-i18n="hero_badge">All you can eat</p>
    <img class="mk rise" data-d="1" src="/{{ stores.logo_wordmark }}" width="996" height="276"
         alt="Farm to Table" fetchpriority="high" decoding="async">
    <h1 class="hero__name rise" data-d="2">{{ store.name }}</h1>
    <div class="hero__cta rise" data-d="3">
      {%- if store.tablecheck_url %}
      <a class="btn btn--fill" href="{{ reserve }}&utm_content=hero" target="_blank" rel="noopener" data-ga-event="reserve_click" data-i18n="cta_reserve_long">Reserve a table</a>
      {%- else %}
      <a class="btn btn--fill" href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click" data-i18n="cta_call_long">Call to reserve</a>
      {%- endif %}
      {%- if store.maps_link %}
      <a class="btn btn--line" href="{{ store.maps_link }}" target="_blank" rel="noopener" data-ga-event="map_click" data-i18n="cta_directions">Get directions</a>
      {%- endif %}
    </div>
  </div>

  <div class="hero__foot">
    <span>{{ store.area_label }}</span>
    {%- if store.hours %}<span>{{ store.hours }}</span>{% endif %}
  </div>
</section>

<!-- ══════════════════════════════════════════ STATEMENT -->
<section class="say px" data-parallax>
  <img class="px__bg" src="/assets/grill-01.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true">
  <div class="px__scrim" aria-hidden="true"></div>
  <div class="wrap say__in">
    <div class="in rise">
      <p class="vlabel"><span data-i18n="say_label">Since 1962</span></p>
      <p class="hlabel" data-i18n="say_label">Since 1962</p>
      <q data-i18n="say_quote">We want you to enjoy truly delicious wagyu to your heart's content.</q>
      <p class="say__by" data-i18n="say_by">Farm to Table — cattle farmers since 1962</p>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════ STORY -->
<section class="sec sec--light" id="story">
  <div class="wrap">
    <div class="in rise">
      <p class="vlabel"><span data-i18n="story_label">Our story</span></p>
      <p class="hlabel" data-i18n="story_label">Our story</p>
      <div class="story__lead">
        <h2 class="t" data-i18n="story_title">1962. Our history began with a single wagyu trader.</h2>
        <div>
          <p class="story__p" data-i18n="story_p1">The founder travelled the country to visit producers, looked at the cattle with his own eyes, and kept choosing only truly good wagyu. That belief was handed down, expanding into meat wholesale, a butcher shop, and then a yakiniku restaurant.</p>
          <p class="story__p" data-i18n="story_p2">But buying alone did not satisfy us.</p>
        </div>
      </div>
    </div>
  </div>

  <figure class="bleed wipe">
    <img src="/{{ store.farm_photo }}" alt="Farm to Table — {{ store.name_short }}" loading="lazy" decoding="async">
    <figcaption data-i18n="story_caption">Our own farm</figcaption>
  </figure>

  <div class="wrap">
    <div class="in rise">
      <blockquote class="story__q" data-i18n="story_quote">We want to deliver more delicious wagyu.</blockquote>
      <div class="story__lead" style="margin-top:clamp(38px,5vw,64px)">
        <div></div>
        <div>
          <p class="story__p" style="margin-top:0" data-i18n="story_p3">Our answer was to raise wagyu ourselves. We took on production, caring for each animal, in pursuit of wagyu we can genuinely stand behind.</p>
          <p class="story__p" data-i18n="story_p4">And there was one more thing we wanted to make happen: we want you to enjoy truly delicious wagyu to your heart's content. So we drew on the eye for quality cultivated over more than 60 years, our relationships with producers, and the strength of raising our own wagyu, and created an all-you-can-eat brand where you can savour wagyu to the full.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════ BRAND MARK -->
<section class="sec sec--light" style="padding-block:clamp(20px,4vw,56px)">
  <div class="wrap">
    <img class="plate rise" src="/{{ stores.logo_illustration }}" width="1000" height="1000"
         alt="Farm to Table — 畜産農家の和牛焼肉食べ放題 / 畜牧农场主经营的和牛烤肉自助 / est. 1962"
         loading="lazy" decoding="async">
  </div>
</section>

<!-- ══════════════════════════════════════════ STRENGTHS -->
<section class="sec sec--light" style="padding-top:0">
  <div class="wrap">
    <div class="in rise">
      <p class="vlabel"><span data-i18n="str_label">Our strengths</span></p>
      <p class="hlabel" data-i18n="str_label">Our strengths</p>
      <div class="str">
        <figure class="str__fig wipe">
          <img src="/{{ store.farmer_photo }}" alt="Farm to Table — {{ store.name_short }}" loading="lazy" decoding="async">
        </figure>
        <div>
          <h2 class="t" style="margin-bottom:clamp(30px,4vw,52px)" data-i18n="str_title">A yakiniku restaurant run by cattle farmers.</h2>
          <div class="str__list">
            <div class="str__row">
              <p class="str__n">01</p>
              <p class="str__k" data-i18n="str_1_k">Over 60 years</p>
              <div>
                <p class="str__t" data-i18n="str_1_t">An eye for quality</p>
                <p class="str__d" data-i18n="str_1_d">Cultivated since 1962 and handed down through the trade.</p>
              </div>
            </div>
            <div class="str__row">
              <p class="str__n">02</p>
              <p class="str__k" data-i18n="str_2_k">Producers</p>
              <div>
                <p class="str__t" data-i18n="str_2_t">Relationships of trust</p>
                <p class="str__d" data-i18n="str_2_d">Built by visiting farms across the country, one producer at a time.</p>
              </div>
            </div>
            <div class="str__row">
              <p class="str__n">03</p>
              <p class="str__k" data-i18n="str_3_k">Our own farm</p>
              <div>
                <p class="str__t" data-i18n="str_3_t">We raise it ourselves</p>
                <p class="str__d" data-i18n="str_3_d">From raising to serving, in our own hands — caring for each animal.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════ WAGYU -->
<section class="sec">
  <div class="wrap">
    <div class="in">
      <p class="vlabel"><span data-i18n="wagyu_label">The wagyu</span></p>
      <p class="hlabel rise" data-i18n="wagyu_label">The wagyu</p>
      <h2 class="t rise" data-i18n="wagyu_title">Wagyu, closer to everyone.</h2>
      <p class="lede rise" data-d="1" style="margin-top:26px" data-i18n="story_p5">We put the dedication of our producers and more than 60 years of craft into every plate.</p>
      <div class="duo">
        <figure class="wipe"><img src="/assets/dish-01.jpg" alt="{{ store.name_short }} — wagyu" loading="lazy" decoding="async"></figure>
        <figure class="wipe"><img src="/assets/dish-02.jpg" alt="{{ store.name_short }} — wagyu" loading="lazy" decoding="async"></figure>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════ COURSES -->
{%- if store.courses.length %}
<section class="sec" id="menu" style="padding-top:0">
  <div class="wrap">
    <div class="in">
      <p class="vlabel"><span data-i18n="menu_label">All you can eat</span></p>
      <p class="hlabel rise" data-i18n="menu_label">All you can eat</p>
      <h2 class="t rise" data-i18n="menu_title">Courses</h2>

      <ol class="board">
        {%- for c in store.courses %}
        <li class="board__row rise{% if c.featured %} is-featured{% endif %}">
          <p class="board__n">{{ "0" + (loop.index | string) }}</p>
          <div class="board__head">
            <h3 class="board__name">{{ c.name }}</h3>
            {%- if c.price %}
            <span class="board__lead" aria-hidden="true"></span>
            <p class="board__price">{{ c.price }}<small class="board__per" data-i18n="menu_per">per person</small></p>
            {%- endif %}
          </div>
          {%- if c.name_jp or c.duration %}
          <p class="board__meta">{{ c.name_jp }}{% if c.name_jp and c.duration %} &nbsp;/&nbsp; {% endif %}{{ c.duration }}</p>
          {%- endif %}
          {%- if c.items.length %}
          <ul class="board__items">{% for i in c.items %}<li>{{ i }}</li>{% endfor %}</ul>
          {%- endif %}
          {%- if c.soft_drinks or c.alcohol %}
          <p class="board__optk" data-i18n="menu_options">Free-flow drink options</p>
          <ul class="board__opts">
            {%- if c.soft_drinks %}<li data-i18n="opt_soft">Soft drinks</li>{% endif %}
            {%- if c.alcohol %}<li data-i18n="opt_alcohol">Alcohol</li>{% endif %}
          </ul>
          {%- endif %}
        </li>
        {%- endfor %}
      </ol>

      {%- if store.drinks %}
      <div class="drinks rise">
        <span class="drinks__k" data-i18n="menu_drinks">Free-flow drinks</span>
        <span class="drinks__n">{{ store.drinks.name_jp }}{% if store.drinks.duration %} / {{ store.drinks.duration }}{% endif %}</span>
        {%- if store.drinks.price %}<span class="drinks__p">{{ store.drinks.price }}</span>{% endif %}
        {%- if store.drinks.note %}<span class="drinks__note">{{ store.drinks.note }}</span>{% endif %}
      </div>
      {%- endif %}

      <p class="note rise" data-i18n="menu_note">Menu may change. Please tell our staff about any allergies.</p>

      {%- if store.tablecheck_url %}
      <div class="after rise">
        <a class="btn btn--fill" href="{{ reserve }}&utm_content=menu" target="_blank" rel="noopener" data-ga-event="reserve_click" data-i18n="cta_reserve_long">Reserve a table</a>
        <p data-i18n="resv_note">Reservations recommended</p>
      </div>
      {%- endif %}
    </div>
  </div>
</section>
{%- endif %}

<!-- ══════════════════════════════════════════ RESERVATION -->
<section class="resv px" id="reserve" data-parallax>
  <img class="px__bg" src="/assets/guests-02.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true">
  <div class="px__scrim" aria-hidden="true"></div>
  <div class="wrap resv__in">
    <div class="in rise">
      <p class="vlabel"><span data-i18n="resv_label">Reservations</span></p>
      <p class="hlabel" data-i18n="resv_label">Reservations</p>
      <h2 class="resv__t" style="margin-top:0" data-i18n="resv_title">Book your table</h2>
      <p class="resv__d" data-i18n="resv_body">Seats fill up quickly, so we recommend reserving in advance. Booking takes about a minute.</p>
      <div class="resv__cta">
        {%- if store.tablecheck_url %}
        <a class="btn btn--fill" href="{{ reserve }}&utm_content=reserve-section" target="_blank" rel="noopener" data-ga-event="reserve_click" data-i18n="cta_reserve_online">Reserve online</a>
        {%- endif %}
        {%- if store.tel_display %}
        <a class="btn btn--line" href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click" data-i18n="cta_call_long">Call to reserve</a>
        {%- endif %}
      </div>
      {%- if store.tel_display %}
      <p class="resv__tel"><a href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click">{{ store.tel_display }}</a>{% if store.hours %} &nbsp;&nbsp;{{ store.hours }}{% endif %}</p>
      {%- endif %}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════ ROOM -->
{%- if store.gallery.length %}
<section class="sec" id="room">
  <div class="wrap">
    <div class="in">
      <p class="vlabel"><span data-i18n="gallery_label">The restaurant</span></p>
      <p class="hlabel rise" data-i18n="gallery_label">The restaurant</p>
      <h2 class="t rise">{{ store.city }}</h2>
      <div class="grid">
        {%- for g in store.gallery %}
        <figure class="shot wipe"><img src="/{{ g.src }}" alt="{{ store.name_short }} — {{ g.caption }}" loading="lazy" decoding="async">
        {%- if g.caption %}<figcaption>{{ g.caption }}</figcaption>{% endif %}</figure>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>
{%- endif %}

<!-- ══════════════════════════════════════════ ACCESS -->
<section class="sec" id="access" style="padding-top:0">
  <div class="wrap">
    <div class="in rise">
      <p class="vlabel"><span data-i18n="access_label">Access</span></p>
      <p class="hlabel" data-i18n="access_label">Access</p>
      <div class="acc{% if not store.maps_embed %} acc--solo{% endif %}">
        <div>
          <h2 class="t"><span data-i18n="access_title">Find us in</span> {{ store.city }}.</h2>
          <div class="rows">
            <div class="rows__r">
              <span class="rows__k" data-i18n="lbl_name">Restaurant</span>
              <span class="rows__v">{{ store.name }}</span>
            </div>
            {%- if store.address_en %}
            <div class="rows__r"><span class="rows__k" data-i18n="lbl_address">Address</span><span class="rows__v">{{ store.address_en }}</span></div>
            {%- endif %}
            {%- if store.station_en %}
            <div class="rows__r"><span class="rows__k" data-i18n="lbl_station">Nearest station</span><span class="rows__v">{{ store.station_en }}{% if store.station_note %}<small>{{ store.station_note }}</small>{% endif %}</span></div>
            {%- endif %}
            {%- if store.hours %}
