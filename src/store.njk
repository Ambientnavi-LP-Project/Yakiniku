  function applyLanguage(lang) {
    var dict = translations[lang] || translations.en;
    document.querySelectorAll('[data-i18n]').forEach(function (el) {
      var key = el.getAttribute('data-i18n');
      if (dict[key] !== undefined) el.innerHTML = dict[key];
    });
    var HTMLLANG = { en:"en", zh:"zh-Hans", ko:"ko" };
    document.documentElement.setAttribute('lang', HTMLLANG[lang] || 'en');
    document.querySelectorAll('.lang button').forEach(function (btn) {
      btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
    });
    try { localStorage.setItem('preferred_lang', lang); } catch (e) {}
    document.dispatchEvent(new Event('langchange'));
  }

  document.querySelectorAll('.lang button').forEach(function (btn) {
    btn.addEventListener('click', function () { applyLanguage(btn.getAttribute('data-lang')); });
  });

  (function initLang() {
    var saved = null;
    try { saved = localStorage.getItem('preferred_lang'); } catch (e) {}
    if (saved && translations[saved]) { if (saved !== 'en') applyLanguage(saved); return; }
    var n = (navigator.language || 'en').toLowerCase();
    if (n.indexOf('ko') === 0) applyLanguage('ko');
    else if (n.indexOf('zh') === 0) applyLanguage('zh');
  })();
