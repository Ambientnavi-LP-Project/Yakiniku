<script>
var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ヘッダー：ヒーローを抜けたら背景を敷く */
(function(){
  var head=document.getElementById('head'), hero=document.querySelector('.hero');
  if(!head||!hero) return;
  var ticking=false;
  function paint(){
    head.classList.toggle('is-solid', hero.getBoundingClientRect().bottom < head.offsetHeight + 8);
    ticking=false;
  }
  addEventListener('scroll',function(){ if(!ticking){ticking=true;requestAnimationFrame(paint);} },{passive:true});
  addEventListener('resize',paint); paint();
})();

/* ヒーローのクロスフェード */
(function(){
  var shots=document.querySelectorAll('.hero__shot');
  if(shots.length<2 || REDUCED) return;
  var i=0;
  setInterval(function(){
    shots[i].classList.remove('is-on');
    i=(i+1)%shots.length;
    shots[i].classList.add('is-on');
  },6200);
})();

/* 視差：背景をスクロール量の一部だけ動かす（背景が固定されて見える） */
(function(){
  if(REDUCED) return;
  var zones=[].slice.call(document.querySelectorAll('[data-parallax]'));
  if(!zones.length) return;
  var ticking=false;
  function paint(){
    var vh=innerHeight;
    zones.forEach(function(z){
      var r=z.getBoundingClientRect();
      if(r.bottom<-200 || r.top>vh+200) return;
      var p=(r.top+r.height/2-vh/2)/vh;          // -1 〜 1
      var y=(-p*9).toFixed(2);
      z.querySelectorAll('.px__bg').forEach(function(img){
        img.style.transform='translate3d(0,'+y+'%,0)';
      });
    });
    ticking=false;
  }
  function onScroll(){ if(!ticking){ ticking=true; requestAnimationFrame(paint); } }
  addEventListener('scroll',onScroll,{passive:true});
  addEventListener('resize',onScroll);
  paint();
})();

/* スクロール表示 */
(function(){
  var items=document.querySelectorAll('.rise,.wipe');
  if(!('IntersectionObserver' in window) || REDUCED){
    items.forEach(function(el){ el.classList.add('is-in'); });
  }else{
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('is-in'); io.unobserve(e.target); } });
    },{rootMargin:'0px 0px -8% 0px',threshold:.04});
    items.forEach(function(el){ io.observe(el); });

    /* 保険：勢いよくスクロールすると observer が取りこぼすことがあるため、
       スクロールのたびに「画面に入った／通り過ぎた」ものを必ず表示する。
       これが無いと、速く送った箇所の写真が出ないまま残る。 */
    var pending=[].slice.call(items), sweeping=false;
    function sweep(){
      var vh=innerHeight;
      pending=pending.filter(function(el){
        if(el.classList.contains('is-in')) return false;
        if(el.getBoundingClientRect().top < vh*0.95){ el.classList.add('is-in'); return false; }
        return true;
      });
      sweeping=false;
      if(!pending.length){
        removeEventListener('scroll',onSweep);
        removeEventListener('resize',onSweep);
      }
    }
    function onSweep(){ if(!sweeping){ sweeping=true; requestAnimationFrame(sweep); } }
    addEventListener('scroll',onSweep,{passive:true});
    addEventListener('resize',onSweep);
    addEventListener('load',onSweep);
    setTimeout(sweep,1200);
  }
  var yr=document.getElementById('yr'); if(yr) yr.textContent=new Date().getFullYear();
})();

/* サイドバー：スクロール進捗と、いま見ている節の強調 */
(function(){
  var bar=document.getElementById('railBar');
  var links=[].slice.call(document.querySelectorAll('.rail__a'));
  var secs=links.map(function(a){ return document.querySelector(a.getAttribute('href')); });
  var ticking=false;
  function paint(){
    if(bar){
      var max=document.documentElement.scrollHeight-innerHeight;
      bar.style.height=(max>0 ? (scrollY/max)*100 : 0)+'%';
    }
    var best=-1, line=innerHeight*0.35;
    secs.forEach(function(s,i){
      if(!s) return;
      var r=s.getBoundingClientRect();
      if(r.top<=line && r.bottom>line) best=i;
    });
    links.forEach(function(a,i){ a.classList.toggle('is-here', i===best); });
    ticking=false;
  }
  function onScroll(){ if(!ticking){ ticking=true; requestAnimationFrame(paint); } }
  addEventListener('scroll',onScroll,{passive:true});
  addEventListener('resize',onScroll);
  paint();
})();
</script>

