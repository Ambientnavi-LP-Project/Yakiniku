            {%- else %}
            <a class="btn btn--fill" href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click" data-i18n="cta_call_long">Call to reserve</a>
            {%- endif %}
            {%- if store.maps_link %}
            <a class="btn btn--line" href="{{ store.maps_link }}" target="_blank" rel="noopener" data-ga-event="map_click" data-i18n="cta_directions">Get directions</a>
            {%- endif %}
          </div>
        </div>

        {%- if store.maps_embed %}
        <div>
          <iframe class="map" src="{{ store.maps_embed }}" title="{{ store.name_short }} map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
        {%- endif %}
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════ FOOTER -->
<footer class="foot">
  <div class="wrap">
    <p class="foot__mark">Farm to Table</p>
    <nav class="foot__links">
      {%- if store.tablecheck_url %}
      <a class="foot__a" href="{{ reserve }}" target="_blank" rel="noopener" data-ga-event="reserve_click">Reservation</a>
      {%- endif %}
      {%- if store.tel_display %}
      <a class="foot__a" href="tel:+{{ store.tel_raw }}" data-ga-event="tel_click">Call</a>
